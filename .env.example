# Copy to apps/web/.env.local (web) and apps/mobile/.env (mobile). Never commit real values.

# --- Web (Next.js) ---------------------------------------------------------
# Supabase project URL and anon/publishable key (safe for browsers; RLS protects data).
# Local defaults come from `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Public URL of the web app, used in email links (confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only secret (32+ random chars) that signs the parent-area unlock cookie.
# Generate with: openssl rand -hex 32
PARENT_GATE_SECRET=replace-with-64-hex-characters

# --- Mobile (Expo) ---------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# --- Tests only (never in an app bundle) -----------------------------------
# Direct Postgres URL for tests/integration (local default shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
