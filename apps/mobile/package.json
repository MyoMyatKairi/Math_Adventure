{
  "name": "@math-adventure/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node ../../scripts/lint-no-eval.mjs src app",
    "test": "jest",
    "bundle:check": "expo export --platform ios --output-dir dist-check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@math-adventure/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|react-native-svg|@supabase/.*|@math-adventure/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-check/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver"
  }
}
